# One Fernet key, or a comma-separated rotation key ring. The first key encrypts new values;
# every key can decrypt existing values. Run `python -m app.cli rotate-secrets` after prepending
# a new key, then remove retired keys only after a successful backup and rotation.
NBM_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_Fernet.generate_key()
# SQLite file location. The container default lives on the persistent /app/data volume.
NBM_DATABASE_PATH=/app/data/netbox_manager.db
# Data Export writes completed and temporary files here. Mount a writable volume at this path.
NBM_EXPORT_DIR=/app/exports
NBM_EXPORT_RETENTION_DAYS=7
NBM_EXPORT_MAX_CONCURRENT_JOBS=2
NBM_EXPORT_MAX_ACTIVE_JOBS_PER_USER=3
NBM_EXPORT_MAX_REQUESTS_PER_SECOND=8
NBM_EXPORT_MAX_ROWS_PER_TYPE=1000000
NBM_EXPORT_MIN_FREE_MIB=200
NBM_CORS_ORIGINS=["http://localhost:5173","https://localhost:8443"]

# API documentation is disabled by default. When enabled it still requires authentication.
NBM_ENABLE_API_DOCS=false
# human or json. JSON includes request_id for log records emitted while handling a request.
NBM_LOG_FORMAT=human
# Emit one structured timing line per request; requests over this threshold log at WARNING.
NBM_REQUEST_TIMING=true
NBM_SLOW_REQUEST_MS=2000
NBM_SESSION_MAX_AGE_HOURS=12
NBM_SESSION_IDLE_TIMEOUT_MINUTES=60
# Avoid a SQLite write on every authenticated request. Must be shorter than the idle timeout.
NBM_SESSION_TOUCH_INTERVAL_SECONDS=60
# Maximum compressed archive download and total uncompressed YAML bytes read.
# The effective cap is lowered if /tmp has less than this plus 8 MiB free.
NBM_ARCHIVE_MAX_MIB=48
# Only one archive scan can use the shared /tmp tmpfs at a time.
NBM_ARCHIVE_LOCK_TIMEOUT_SECONDS=120
# Days to retain mutation audit and push-history rows; 0 keeps them forever.
NBM_AUDIT_RETENTION_DAYS=365
# Scheduled drift detection; 0 disables the scheduler job.
NBM_DRIFT_CHECK_INTERVAL_HOURS=6
NBM_DRIFT_WORKERS=8
NBM_DRIFT_PER_INSTANCE_WORKERS=2
NBM_DRIFT_FULL_RECHECK_EVERY=10
# Experimental until multi-value template filters are verified across supported NetBox releases.
NBM_DRIFT_BULK_COMPONENT_READS=false
# Experimental change-log shortcut; falls back to normal markers when unavailable.
NBM_DRIFT_USE_CHANGELOG=false
# Look back this far to tolerate clock skew and drift-run persistence delays.
NBM_DRIFT_CHANGELOG_MARGIN_SECONDS=300
NBM_SEARCH_LIMIT_PER_TYPE=50
NBM_SEARCH_TIMEOUT_SECONDS=15
NBM_FLEET_CACHE_SECONDS=30
NBM_FLEET_TIMEOUT_SECONDS=15
# Resume interrupted migration jobs at startup, at most this many times per job.
NBM_MIGRATION_AUTO_RESUME=true
NBM_MIGRATION_MAX_AUTO_RESUMES=3

# --- Authentication ---
# Authentication and authorization are enforced by default. This deliberately has no NBM_
# prefix. Set it to True only when you explicitly want the application to run completely open.
AUTHENTICATION_DISABLED=False

# Issuer is the base URL your provider publishes /.well-known/openid-configuration under,
# e.g. https://accounts.google.com, https://login.microsoftonline.com/<tenant>/v2.0,
# https://your-okta-domain/oauth2/default, or your Keycloak realm URL.
#NBM_OIDC_ISSUER=
NBM_OIDC_CLIENT_ID=
NBM_OIDC_CLIENT_SECRET=
# Must exactly match the redirect URI registered with your provider, and be reachable
# by the user's browser (this is the public-facing HTTPS address through Caddy on :8443 in
# the default Docker Compose setup, not the internal Uvicorn listener).
NBM_OIDC_REDIRECT_URI=https://localhost:8443/api/auth/callback
NBM_OIDC_SCOPES=openid profile email groups
# The ID token claim holding group membership. Varies by provider/config:
# Keycloak often uses "groups" via a mapper, Azure AD/Entra ID uses "groups" (object IDs)
# or "roles", Okta needs a custom "groups" claim added to the auth server. Check your
# provider's ID token contents and adjust this to match.
NBM_OIDC_GROUPS_CLAIM=groups

# Optional break-glass local administrator. Set both values or the application will refuse to
# start. Use a long random password and set NBM_SESSION_COOKIE_SECURE=true
# whenever the app is served over HTTPS.
NBM_LOCAL_ADMIN_USER=
NBM_LOCAL_ADMIN_PASSWORD=
# --- Access control ---
# Group(s) allowed to manage NetBox Manager itself (instances, GitHub targets, and the
# access mappings below) — comma-separated if more than one. Set this to your real
# admin/network-ops group's name (as it appears in the groups claim) and leave it set
# permanently; it's not a one-time bootstrap step, it's how the app knows who's an admin
# even before any access mappings exist in the database.
NBM_BOOTSTRAP_ADMIN_GROUPS=
# Role granted to an authenticated user whose groups match neither NBM_BOOTSTRAP_ADMIN_GROUPS
# nor any access mapping created in the Access Control page. "viewer" is read-only everywhere;
# safe to hand out broadly to anyone with SSO access rather than support-ticket new users in.
NBM_DEFAULT_ROLE=viewer

# Signs Authlib's short-lived OIDC state cookie (separate from server-side identity sessions and
# NBM_SECRET_KEY, which encrypts stored tokens).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NBM_SESSION_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
# HTTPS is always enabled by the container deployment.
NBM_SESSION_COOKIE_SECURE=true

# --- Syslog forwarding of the audit log (RFC 5424). Config-file only —
# these are not editable from the UI, only viewable, plus a test-send button.
NBM_SYSLOG_ENABLED=false
NBM_SYSLOG_PROTOCOL=udp
NBM_SYSLOG_HOST=
NBM_SYSLOG_PORT=514
NBM_SYSLOG_FACILITY=local0
NBM_SYSLOG_APP_NAME=netbox-manager
# Reference-data repository locations are configured per GitHub target (default: reference-data).

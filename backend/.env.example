NBM_DATABASE_URL=sqlite:////app/data/netbox_manager.db
NBM_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_Fernet.generate_key()

# --- OIDC login (leave NBM_OIDC_ISSUER empty to run with auth disabled, e.g. local dev) ---
# Issuer is the base URL your provider publishes /.well-known/openid-configuration under,
# e.g. https://accounts.google.com, https://login.microsoftonline.com/<tenant>/v2.0,
# https://your-okta-domain/oauth2/default, or your Keycloak realm URL.
#NBM_OIDC_ISSUER=
NBM_OIDC_CLIENT_ID=
NBM_OIDC_CLIENT_SECRET=
# Must exactly match the redirect URI registered with your provider, and be reachable
# by the user's browser (this is the public-facing address, i.e. through nginx on :8080
# in the default docker-compose setup, not the backend's internal :8000).
NBM_OIDC_REDIRECT_URI=http://localhost:8080/api/auth/callback
NBM_OIDC_SCOPES=openid profile email groups
# The ID token claim holding group membership. Varies by provider/config:
# Keycloak often uses "groups" via a mapper, Azure AD/Entra ID uses "groups" (object IDs)
# or "roles", Okta needs a custom "groups" claim added to the auth server. Check your
# provider's ID token contents and adjust this to match.
NBM_OIDC_GROUPS_CLAIM=groups

# --- Access control ---
# Group(s) allowed to manage NetBox Manager itself (instances, GitHub targets, and the
# role/scope mappings below) — comma-separated if more than one. Set this to your real
# admin/network-ops group's name (as it appears in the groups claim) and leave it set
# permanently; it's not a one-time bootstrap step, it's how the app knows who's an admin
# even before any role_mappings exist in the database.
NBM_BOOTSTRAP_ADMIN_GROUPS=
# Role granted to an authenticated user whose groups match neither NBM_BOOTSTRAP_ADMIN_GROUPS
# nor any role_mapping created in the Access Control page. "viewer" is read-only everywhere;
# safe to hand out broadly to anyone with SSO access rather than support-ticket new users in.
NBM_DEFAULT_ROLE=viewer

# Signs the session cookie (separate from NBM_SECRET_KEY, which encrypts stored tokens).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NBM_SESSION_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
# Set true once served over HTTPS (required for the cookie to be sent at all in production).
NBM_SESSION_COOKIE_SECURE=false

# --- Syslog forwarding of the audit log (RFC 5424). Config-file only —
# these are not editable from the UI, only viewable, plus a test-send button.
NBM_SYSLOG_ENABLED=false
NBM_SYSLOG_PROTOCOL=udp
NBM_SYSLOG_HOST=
NBM_SYSLOG_PORT=514
NBM_SYSLOG_FACILITY=local0
NBM_SYSLOG_APP_NAME=netbox-manager
